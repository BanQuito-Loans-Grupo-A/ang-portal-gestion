{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "5c1ba9d0-5c63-419a-8707-313a0b7177ce"
  },
  "newProjectRoot": "projects",
  "projects": {
    "portal-gestion": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/portal-gestion",
      "sourceRoot": "projects/portal-gestion/src",
      "prefix": "pg",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portal-gestion/src/main.ts",
            "tsConfig": "projects/portal-gestion/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portal-gestion/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/assets",
                "output": "img"
              }
            ],
            "styles": [
              "projects/portal-gestion/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "real": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/portal-gestion/src/entorno.ts",
                  "with": "projects/portal-gestion/src/entorno.real.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portal-gestion:build:production"
            },
            "development": {
              "buildTarget": "portal-gestion:build:development"
            },
            "real": {
              "buildTarget": "portal-gestion:build:real"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "bq",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
